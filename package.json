{
  "name": "tanstarter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CI=true wrangler d1 migrations apply stroke-web --local && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler types && CI=true wrangler d1 migrations apply stroke-web --remote; wrangler deploy",
    "migrate:local": "CI=true wrangler d1 migrations apply stroke-web --local",
    "migrate:remote": "CI=true wrangler d1 migrations apply stroke-web --remote",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format && pnpm lint",
    "prepare": "husky",
    "db": "drizzle-kit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "cf-gen": "wrangler types",
    "deps": "pnpm dlx taze@latest -Ilw --maturity-period 3",
    "tanstack": "pnpm dlx @tanstack/cli@latest",
    "ui": "pnpm dlx shadcn@latest",
    "auth": "pnpm dlx auth@latest",
    "auth:secret": "pnpm dlx auth@latest secret",
    "auth:generate": "pnpm dlx auth@latest generate --config ./src/lib/auth/auth.ts --y --output ./src/lib/db/schema/auth.schema.ts",
    "auth:migrate": "pnpm run auth:generate && pnpm run db generate && pnpm run db push",
    "skills": "pnpm dlx skills@latest",
    "intent": "pnpm dlx @tanstack/intent@latest"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@better-auth/drizzle-adapter": "1.6.14",
    "@fontsource-variable/inter": "5.2.8",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-router": "1.170.11",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.19",
    "better-auth": "1.6.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dodopayments": "^2.36.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.10.0",
    "sonner": "2.0.7",
    "standardwebhooks": "^1.0.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/devtools-a11y": "0.1.3",
    "@tanstack/devtools-vite": "0.7.0",
    "@tanstack/eslint-plugin-query": "5.101.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/react-devtools": "0.10.5",
    "@tanstack/react-query-devtools": "5.101.0",
    "@tanstack/react-router-devtools": "1.167.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.10",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "wrangler": "latest"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "generator": "create-mugnavo"
}
